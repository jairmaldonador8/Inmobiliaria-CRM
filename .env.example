NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
EASYBROKER_API_KEY=
EASYBROKER_BASE_URL=https://api.stagingeb.com
CRON_SECRET=
# Web Push (VAPID) — generar con `npx web-push generate-vapid-keys`. Las
# claves son permanentes: rotarlas invalida TODAS las suscripciones activas.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@klo-ser.test
# Google Calendar (ver README → «Integración con Google Calendar»).
# GOOGLE_TOKEN_SECRET: 32 bytes en base64, `openssl rand -base64 32`. Cifra los
# refresh tokens de los asesores en reposo — perderla obliga a que todos
# reconecten su calendario.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
